{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://el-jardin-de-la-macetas-app-8rssws-51e10e-187-77-212-199.sslip.io/api"
      }
    },
    "local": {
      "env": {
        "EXPO_PUBLIC_API_URL": "http://sistema-funkos.test/api"
      }
    },
    "staging": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://el-jardin-de-la-macetas-app-8rssws-51e10e-187-77-212-199.sslip.io/api"
      },
      "autoIncrement": true,
      "channel": "staging"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://eljardindelasmacetas.com/api"
      },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./path-to-service-account.json",
        "track": "production"
      }
    }
  }
}
