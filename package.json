{
  "name": "app-funkos",
  "version": "1.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "axios": "^1.18.1",
    "expo": "~56.0.12",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "~56.0.27",
    "expo-font": "~56.0.7",
    "expo-image-manipulator": "~56.0.25",
    "expo-image-picker": "^56.0.18",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\"",
    "start:local": "APP_ENV=local EXPO_PUBLIC_API_URL=http://sistema-funkos.test/api expo start",
    "start:staging": "APP_ENV=staging EXPO_PUBLIC_API_URL=https://dev.eljardindelasmacetas.com/api expo start",
    "start:production": "APP_ENV=production EXPO_PUBLIC_API_URL=https://eljardindelasmacetas.com/api expo start",
    "build:local": "eas build --profile local --platform all",
    "build:staging": "eas build --profile staging --platform all",
    "build:production": "eas build --profile production --platform all",
    "submit:production": "eas submit --profile production --platform all --latest"
  },
  "private": true
}
